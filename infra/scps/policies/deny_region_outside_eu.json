{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideEURegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "cloudfront:*",
        "route53:*",
        "route53domains:*",
        "sts:*",
        "support:*",
        "waf:*",
        "wafv2:*",
        "budgets:*",
        "ce:*",
        "cur:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "eu-west-1",
            "eu-west-3"
          ]
        }
      }
    }
  ]
}