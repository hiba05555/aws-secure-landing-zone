{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyModifyCloudTrailLogs",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:PutBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::*-cloudtrail-*",
        "arn:aws:s3:::*-cloudtrail-*/*"
      ]
    }
  ]
}